{
  "manifest_version": 3,
  "name": "FlightWifi (working title)",
  "version": "1.0.0",
  "description": "See who runs the wifi on every flight, and whether you can actually work on it, before you book.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "alarms",
    "storage"
  ],
  "background": {
    "service_worker": "dev-reload.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/travel/flights*"
      ],
      "js": [
        "google-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.google.com/travel/flights*"
      ],
      "js": [
        "data/registry.js",
        "core.js",
        "google.js"
      ],
      "css": [
        "chip.css"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "*://www.skyscanner.net/transport/flights/*",
        "*://www.skyscanner.com/transport/flights/*",
        "*://www.skyscanner.co.uk/transport/flights/*",
        "*://www.skyscanner.co.in/transport/flights/*"
      ],
      "js": [
        "data/registry.js",
        "core.js",
        "skyscanner.js"
      ],
      "css": [
        "chip.css"
      ],
      "run_at": "document_end"
    }
  ]
}